# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth2 — used for BOTH Drive access AND "Sign in with Google" login.
# Create credentials (Application type: Web application) at console.cloud.google.com.
# Add ALL of these as Authorized redirect URIs on the OAuth client:
#   http://localhost:3000/oauth/callback                    (local Drive connect)
#   http://localhost:5173/api/auth/google/callback          (local login, only if AUTH_ENABLED=1)
#   https://YOUR-APP.onrender.com/api/auth/google/callback   (production login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Google Drive folder ID (from the URL of your shared folder)
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Drive token for HOSTED deploys (optional). Locally, the in-app "Connect Drive"
# button writes credentials/oauth-token.json. To enable Drive in the hosted app,
# paste that file's JSON contents here as a single line.
GOOGLE_DRIVE_TOKEN=

# --- Web app login / access gate -------------------------------------------
# Auth is enforced automatically when NODE_ENV=production. To exercise it
# locally, set AUTH_ENABLED=1 (otherwise local dev skips login for convenience).
AUTH_ENABLED=
# Public origin of the deployed app, no trailing slash. Builds the OAuth
# callback URL. For local login testing use http://localhost:5173
BASE_URL=
# Comma-separated list of Google emails with FULL access ("members").
#
# NOTE: this is no longer a gate on signing in. Any account with a verified
# Google email can sign in and READ - the library, transcriptions, page scans,
# and the pre-computed sentiment scores, including downloads. This list decides
# who can also WRITE (edit pages, create dimensions, load lexicons) and who can
# SPEND (anything that calls Claude, and connecting Drive). Everyone else is a
# guest. Roles are resolved per request, so adding or removing an address takes
# effect immediately - no redeploy, no re-login.
#
# Optional: defaults to the owners baked into src/http/session.ts.
ALLOWED_EMAILS=mitchellornesmith@gmail.com,jamesahs@umich.edu
# Secret that signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# SQLite database path (only used when Postgres is not configured)
# Default: ~/.ocr-mcp/books.db
DATABASE_PATH=./data/books.db

# Credentials directory for storing OAuth tokens
CREDENTIALS_PATH=./credentials

# External PostgreSQL (Neon). Set DATABASE_URL for the hosted app.
# Primary: separate vars (recommended for enterprise/secrets managers)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
# Alternative: single connection string (overrides separate vars if set)
DATABASE_URL=

# Application user identity (optional — stamped on records for attribution)
APP_USER_ID=

# --- Object storage for page images (Cloudflare R2) -------------------------
# When set, page images live in R2 instead of base64 in the DB, and new renders
# use IMAGE_RENDER_SCALE. Leave blank to keep base64-in-DB. Create a bucket + an
# R2 API token (Object Read & Write) at dash.cloudflare.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Page render scale when object storage is on (3 ≈ 216 DPI, zoom-able).
IMAGE_RENDER_SCALE=3

# --- Sentiment analysis ------------------------------------------------------
# Ceiling on Claude calls for a single STANDARD run from the web app's /analysis
# screen (one call per page x dimension) - the kind someone waits on. Runs above
# it are refused before spending. Bag-of-words runs are local and free, and
# ignore this. Defaults to 500.
# MAX_LLM_CALLS_PER_RUN=500

# Ceiling on items in one BATCH submission. Much higher, because a batch costs
# about half as much and nobody is waiting on it. Defaults to 20000.
# MAX_BATCH_ITEMS_PER_RUN=20000

# Where dictionary files are looked for on startup (see lexicons/README.md).
# Defaults to ./lexicons.
# LEXICON_DIR=./lexicons

# Port — hosts like Render set $PORT automatically; local backend defaults to 5180.
# PORT=
