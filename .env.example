# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth2 — used for BOTH Drive access AND "Sign in with Google" login.
# Create credentials (Application type: Web application) at console.cloud.google.com.
# Add ALL of these as Authorized redirect URIs on the OAuth client:
#   http://localhost:3000/oauth/callback                    (local Drive connect)
#   http://localhost:5173/api/auth/google/callback          (local login, only if AUTH_ENABLED=1)
#   https://YOUR-APP.onrender.com/api/auth/google/callback   (production login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Google Drive folder ID (from the URL of your shared folder)
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Drive token for HOSTED deploys (optional). Locally, the in-app "Connect Drive"
# button writes credentials/oauth-token.json. To enable Drive in the hosted app,
# paste that file's JSON contents here as a single line.
GOOGLE_DRIVE_TOKEN=

# --- Web app login / access gate -------------------------------------------
# Auth is enforced automatically when NODE_ENV=production. To exercise it
# locally, set AUTH_ENABLED=1 (otherwise local dev skips login for convenience).
AUTH_ENABLED=
# Public origin of the deployed app, no trailing slash. Builds the OAuth
# callback URL. For local login testing use http://localhost:5173
BASE_URL=
# Comma-separated allowlist of Google emails permitted to sign in.
ALLOWED_EMAILS=you@example.com,james@example.com
# Secret that signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# SQLite database path (only used when Postgres is not configured)
# Default: ~/.ocr-mcp/books.db
DATABASE_PATH=./data/books.db

# Credentials directory for storing OAuth tokens
CREDENTIALS_PATH=./credentials

# External PostgreSQL (Neon). Set DATABASE_URL for the hosted app.
# Primary: separate vars (recommended for enterprise/secrets managers)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
# Alternative: single connection string (overrides separate vars if set)
DATABASE_URL=

# Application user identity (optional — stamped on records for attribution)
APP_USER_ID=

# Port — hosts like Render set $PORT automatically; local backend defaults to 5180.
# PORT=
