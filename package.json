{
  "name": "ocr-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for OCR transcription of books from Google Drive using Claude vision",
  "type": "module",
  "main": "out/main/main.js",
  "bin": {
    "ocr-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "ui/dist/",
    "out/"
  ],
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build",
    "build:app": "electron-vite build",
    "build:all": "npm run build:ui && npm run build",
    "start": "node dist/index.js",
    "start:app": "electron-vite preview",
    "dev": "tsx src/index.ts",
    "dev:app": "electron-vite dev",
    "test": "tsx --test scripts/test-render.ts",
    "typecheck:electron": "tsc -p tsconfig.electron.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Father-Pumpkin/ocr.git"
  },
  "homepage": "https://github.com/Father-Pumpkin/ocr",
  "bugs": {
    "url": "https://github.com/Father-Pumpkin/ocr/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "ocr",
    "anthropic",
    "claude",
    "google-drive",
    "transcription"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/ext-apps": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.10.1",
    "@napi-rs/canvas": "^0.1.57",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "pdfjs-dist": "^4.4.168",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.0",
    "electron-vite": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
